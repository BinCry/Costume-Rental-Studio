Project costume_rental_studio {
  database_type: 'PostgreSQL'
  Note: 'ERD design source for Costume Rental Studio. Prisma models and SQL migrations implement this design; raw PostgreSQL constraints are documented in database-constraints.md.'
}

// ============================================================
// ENUMS
// ============================================================

Enum user_status {
  PENDING
  ACTIVE
  LOCKED
  INACTIVE
}

Enum branch_status {
  ACTIVE
  INACTIVE
}

Enum actor_group {
  ADMIN
  STAFF
  CUSTOMER
}

Enum permission_scope {
  OWN
  BRANCH
  ALL
}

Enum catalog_status {
  ACTIVE
  INACTIVE
}

Enum billing_day_mode {
  CALENDAR_DAY
  ROLLING_24_HOURS
}

Enum discount_type {
  PERCENT
  FIXED_AMOUNT
}

Enum unit_operational_status {
  INBOUND
  READY
  CLEANING
  REPAIR
  IN_TRANSFER
  RETIRED
}

Enum costume_condition_grade {
  UNINSPECTED
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

Enum employment_status {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

Enum unit_block_type {
  CLEANING
  REPAIR
  ALTERATION
  INSPECTION
  INTERNAL_USE
  MANUAL
  OTHER
}

Enum unit_block_status {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

Enum transfer_status {
  REQUESTED
  APPROVED
  IN_TRANSIT
  RECEIVED
  REJECTED
  CANCELLED
}

Enum order_status {
  DRAFT
  PENDING_CONFIRMATION
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  ACTIVE
  RETURN_INSPECTION
  COMPLETED
  REJECTED
  CANCELLED
  NO_SHOW
}

Enum allocation_status {
  UNASSIGNED
  HELD
  CONFIRMED
  ACTIVE
  RELEASED
  COMPLETED
}

Enum inspection_status {
  PENDING_ASSESSMENT
  PASSED
  HAS_DAMAGE
  HAS_MISSING_ITEM
  COMPLETED
}

Enum payment_status {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

Enum payment_purpose {
  RENTAL
  DEPOSIT
  EXTRA
}

Enum payment_method {
  CASH
  BANK_TRANSFER
  PAYMENT_GATEWAY
}

Enum refund_status {
  REQUESTED
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
}

Enum crm_case_status {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

Enum crm_case_priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

Enum customer_interaction_type {
  INQUIRY
  CONSULTATION
  COMPLAINT
  FOLLOW_UP
  NOTE
}

Enum interaction_channel {
  IN_PERSON
  PHONE
  EMAIL
  CHAT
  SOCIAL
}

Enum crm_case_event_type {
  CREATED
  STATUS_CHANGED
  OWNER_CHANGED
}

Enum outbox_status {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

// ============================================================
// IDENTITY, BRANCHES AND PERMISSIONS
// ============================================================

Table users {
  id uuid [pk]
  email varchar(255) [unique]
  phone varchar(30) [unique]
  password_hash varchar(255)
  phone_verified_at timestamptz
  display_name varchar(255) [not null]
  avatar_url varchar(500)
  status user_status [not null]
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Shared identity/account entity. Require at least one of email or phone. Normalize email to lowercase and phone to E.164 before persistence. Set status explicitly: verified/self-registered customers normally start ACTIVE; admin-provisioned employees remain PENDING until a verified Google identity is linked.'
}

Table auth_identities {
  id uuid [pk]
  user_id uuid [not null]
  provider varchar(50) [not null]
  provider_subject varchar(255) [not null]
  email_at_link_time varchar(255) [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (provider, provider_subject) [unique]
    (user_id, provider) [unique]
  }

  Note: 'Google and future external identities. Provider subject, not email, is the stable identity key.'
}

Table refresh_sessions {
  id uuid [pk]
  user_id uuid [not null]
  family_id uuid [not null]
  token_hash varchar(64) [not null, unique]
  expires_at timestamptz [not null]
  used_at timestamptz
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    family_id
    user_id
  }

  Note: 'Opaque random refresh tokens; only SHA256 hashes are persisted. Each rotation consumes the old token and creates a new row in the same family, retaining the seven-day absolute expiry. Replay revokes the whole family. User deletion cascades sessions. Used rows must be kept until family expiry for replay detection.'
}

Table phone_otp_challenges {
  id uuid [pk]
  phone varchar(30) [not null, unique]
  code_hash varchar(64) [not null]
  attempt_count int [not null, default: 0]
  expires_at timestamptz [not null]
  sent_at timestamptz
  consumed_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  Note: 'One latest registration challenge per phone. HMAC-SHA256 protects the OTP; secret stays outside the database. Five-minute expiry, five attempts, sixty-second resend cooldown, single use. Resend replaces the challenge UUID. Not linked to users, so requesting OTP does not reveal account existence.'
}

Table employees {
  user_id uuid [pk]
  employee_code varchar(50) [not null, unique]
  employment_status employment_status [not null, default: 'ACTIVE']
  joined_at date [not null]
  terminated_at date
  activated_at timestamptz
  created_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Employee-only business data. Admin provisions this row before first login. activated_at is set only after the employee claims the account using the exact verified Google email. TERMINATED requires terminated_at; role and branch access live in user_role_assignments.'
}

Table branches {
  id uuid [pk]
  branch_code varchar(50) [not null, unique]
  name varchar(255) [not null]
  address text [not null]
  phone varchar(30)
  timezone varchar(100) [not null, default: 'Asia/Ho_Chi_Minh']
  status branch_status [not null, default: 'ACTIVE']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'All branches currently share the same opening hours, managed as application configuration rather than per-branch database rows.'
}

Table roles {
  id uuid [pk]
  role_code varchar(100) [not null, unique]
  name varchar(255) [not null]
  actor_group actor_group [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table permissions {
  id uuid [pk]
  code varchar(150) [not null, unique]
  module varchar(100) [not null]
  action varchar(100) [not null]
  scope permission_scope [not null]
  description text
  created_at timestamptz [not null, default: `now()`]
}

Table role_permissions {
  role_id uuid [not null]
  permission_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (role_id, permission_id) [pk]
  }
}

Table user_role_assignments {
  id uuid [pk]
  user_id uuid [not null]
  role_id uuid [not null]
  branch_id uuid
  assigned_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, role_id, branch_id) [unique]
    (branch_id, role_id)
  }

  Note: 'Assigns a role to a user, optionally within one branch. Null branch_id means a global assignment. PostgreSQL migration should use UNIQUE NULLS NOT DISTINCT (user_id, role_id, branch_id), or equivalent partial indexes, so global assignments cannot be duplicated.'
}

// ============================================================
// CATALOG, PHYSICAL INVENTORY AND TRANSFERS
// ============================================================

Table costume_categories {
  id uuid [pk]
  parent_id uuid
  name varchar(255) [not null]
  status catalog_status [not null, default: 'ACTIVE']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    parent_id
  }
}

Table costume_models {
  id uuid [pk]
  model_code varchar(50) [not null, unique]
  category_id uuid [not null]
  name varchar(255) [not null]
  short_description varchar(500)
  description text
  material varchar(255)
  status catalog_status [not null, default: 'ACTIVE']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (category_id, status)
  }
}

Table costume_model_accessories {
  id uuid [pk]
  model_id uuid [not null]
  name varchar(255) [not null]
  default_quantity int [not null, default: 1]
  replacement_value_vnd bigint
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (model_id, name) [unique]
  }

  Note: 'Master checklist of accessories included with a costume model. Require default_quantity > 0 and replacement_value_vnd >= 0 when set. Deactivate an accessory instead of deleting it after it has been referenced by an order.'
}

Table costume_variants {
  id uuid [pk]
  variant_code varchar(50) [not null, unique]
  model_id uuid [not null]
  size_code varchar(50) [not null]
  color_code varchar(50) [not null]
  edition_label varchar(100)
  fit_notes text
  daily_rental_price_vnd bigint [not null]
  deposit_amount_vnd bigint [not null]
  replacement_value_vnd bigint [not null]
  cleaning_buffer_minutes int
  status catalog_status [not null, default: 'ACTIVE']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (model_id, status)
  }

  Note: 'Chain-wide rental price and deposit source. Price, deposit and replacement value must be non-negative. Confirmed orders preserve their own price snapshot.'
}

Table costume_media {
  id uuid [pk]
  model_id uuid
  variant_id uuid
  object_key varchar(500) [not null]
  sort_order int [not null, default: 0]
  alt_text varchar(500)
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (model_id, sort_order)
    (variant_id, sort_order)
  }

  Note: 'Stores object-storage keys and metadata, never image binaries. Exactly one of model_id or variant_id must be set: model media links directly to a model, while variant-specific media links only to that variant.'
}

Table costume_units {
  id uuid [pk]
  unit_code varchar(50) [not null, unique]
  variant_id uuid [not null]
  current_branch_id uuid [not null]
  condition_grade costume_condition_grade [not null, default: 'UNINSPECTED']
  condition_notes text
  operational_status unit_operational_status [not null, default: 'INBOUND']
  acquired_at date
  acquisition_cost_vnd bigint
  retired_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (variant_id, current_branch_id, operational_status)
    (current_branch_id, operational_status)
  }

  Note: 'Admin pre-registers a physical unit for its designated branch with UNINSPECTED/INBOUND. current_branch_id on an INBOUND unit means the branch responsible for receiving it, not proof that the unit is physically available. The assigned branch inventory staff records a RECEIVED event and changes it to READY, CLEANING or REPAIR after inspection. INBOUND requires UNINSPECTED; every post-receipt status requires an inspected condition other than UNINSPECTED. Only READY units are rentable; a unit cannot return to INBOUND after receipt. acquisition_cost_vnd must be non-negative. RETIRED requires retired_at; non-retired units keep retired_at null.'
}

Table unit_events {
  id uuid [pk]
  unit_id uuid [not null]
  stock_transfer_id uuid
  event_type varchar(50) [not null]
  from_branch_id uuid
  to_branch_id uuid
  recorded_by uuid
  occurred_at timestamptz [not null, default: `now()`]
  notes text

  indexes {
    (unit_id, occurred_at)
  }

  Note: 'Lifecycle log. REGISTERED records admin pre-registration; RECEIVED records branch receipt and inspection. Direct updates are forbidden; retention/admin may delete old rows. Optional transfer, branch and recorder links become null if their parent is deleted; deleting the owning unit cascades its events.'
}

Table unit_blocks {
  id uuid [pk]
  unit_id uuid [not null]
  block_type unit_block_type [not null]
  status unit_block_status [not null, default: 'PLANNED']
  blocked_from timestamptz [not null]
  blocked_until timestamptz [not null]
  assigned_to uuid
  cost_vnd bigint
  reason text [not null]
  notes text
  started_at timestamptz
  finished_at timestamptz
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (unit_id, blocked_from, blocked_until)
    (assigned_to, status, blocked_from)
  }

  Note: 'Unified unavailability and maintenance workflow. PLANNED/IN_PROGRESS blocks make the unit unavailable. Deleting the owning unit cascades its blocks; assigned_to and created_by become null if the employee is deleted. Require blocked_from < blocked_until and cost_vnd >= 0 when set.'
}

Table stock_transfers {
  id uuid [pk]
  transfer_code varchar(50) [not null, unique]
  from_branch_id uuid [not null]
  to_branch_id uuid [not null]
  status transfer_status [not null, default: 'REQUESTED']
  request_note text

  requested_by uuid [not null]

  approved_by uuid
  approved_at timestamptz

  shipped_by uuid
  shipped_at timestamptz

  received_by uuid
  received_at timestamptz

  ended_by uuid
  ended_at timestamptz
  end_reason text

  version int [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (from_branch_id, status)
    (to_branch_id, status)
  }

  Note: 'Source and destination must differ. created_at is also the request time. REQUESTED is editable; items freeze after approval. REJECTED or CANCELLED requires ended_by, ended_at and end_reason. Shipment marks units IN_TRANSFER while current_branch_id remains the source. Receipt updates current_branch_id and each item post-inspection operational status in one transaction.'
}

Table stock_transfer_items {
  id uuid [pk]
  transfer_id uuid [not null]
  unit_id uuid [not null]
  condition_out costume_condition_grade
  condition_out_notes text
  condition_in costume_condition_grade
  condition_in_notes text
  received_operational_status unit_operational_status

  indexes {
    (transfer_id, unit_id) [unique]
    unit_id
  }

  Note: 'condition_out is required when shipping; condition_in and received_operational_status are required when receiving. Transfer conditions cannot be UNINSPECTED, and received_operational_status cannot be INBOUND or IN_TRANSFER after receipt. A unit cannot belong to more than one active transfer.'
}

// ============================================================
// POLICY AND PROMOTIONS
// ============================================================

Table rental_policy_versions {
  id uuid [pk]
  version_code varchar(50) [not null, unique]
  effective_from timestamptz [not null]
  effective_to timestamptz
  billing_day_mode billing_day_mode [not null]
  min_rental_days int [not null, default: 1]
  max_rental_days int
  quote_valid_hours int [not null]
  no_show_grace_minutes int [not null, default: 0]
  late_grace_minutes int [not null, default: 0]
  late_fee_percent_per_day decimal(5,2) [not null, default: 0]
  late_return_buffer_minutes int [not null, default: 0]
  default_cleaning_buffer_minutes int [not null, default: 0]
  late_fee_formula_version int [not null, default: 1]
  free_cancel_before_hours int [not null, default: 0]
  late_cancel_fee_percent decimal(5,2) [not null, default: 0]
  refund_sla_business_days int
  created_by uuid
  change_reason text [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (effective_from, effective_to)
  }

  Note: 'Chain-wide immutable policy version. Effective periods must not overlap. Require effective_from < effective_to when effective_to is set; min_rental_days >= 1; max_rental_days is null or >= min_rental_days; time values including late_return_buffer_minutes and default_cleaning_buffer_minutes >= 0; late_fee_formula_version is 1 or 2; percentage values between 0 and 100. Close the current version and insert a new row for every policy change.'
}

Table promotions {
  id uuid [pk]
  code varchar(100) [not null, unique]
  name varchar(255) [not null]
  discount_type discount_type [not null]
  discount_value bigint [not null]
  max_discount_vnd bigint
  min_order_amount_vnd bigint [not null, default: 0]
  start_at timestamptz [not null]
  end_at timestamptz [not null]
  total_usage_limit int
  per_customer_limit int [not null, default: 1]
  is_active boolean [not null, default: true]
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (is_active, start_at, end_at)
  }

  Note: 'One promotion may be applied to an order. Require start_at < end_at, discount_value > 0, percentage discounts <= 100, non-negative amount fields, and positive usage limits when set.'
}

// ============================================================
// RENTAL ORDERS AND ITEMS
// ============================================================

Table rental_orders {
  id uuid [pk]
  order_code varchar(50) [not null, unique]
  customer_user_id uuid [not null]
  pickup_branch_id uuid [not null]
  channel varchar(30) [not null]
  planned_start_at timestamptz [not null]
  planned_due_at timestamptz [not null]
  customer_note text
  status order_status [not null, default: 'DRAFT']
  policy_version_id uuid [not null]
  promotion_id uuid
  promotion_code varchar(100)
  promotion_discount_vnd bigint [not null, default: 0]
  quote_expires_at timestamptz
  created_by uuid [not null]
  pickup_processed_by uuid
  picked_up_at timestamptz
  return_processed_by uuid
  returned_at timestamptz
  inspection_status inspection_status
  return_notes text
  late_fee_vnd bigint [not null, default: 0]
  other_fee_vnd bigint [not null, default: 0]
  deposit_deduction_vnd bigint [not null, default: 0]
  settlement_note text
  financially_settled_at timestamptz
  version int [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (pickup_branch_id, status, planned_start_at)
    (customer_user_id, created_at)
    (promotion_id, status)
    (status, quote_expires_at)
  }

  Note: 'The ordering customer picks up and returns at pickup_branch_id; pickup_processed_by is the counter employee, not a courier. One pickup, one return and at most one promotion per order. picked_up_at requires pickup_processed_by. Without a promotion, promotion_id/code are null and promotion_discount_vnd is zero; with one, promotion_code and the computed discount become immutable snapshots after confirmation. Require planned_start_at < planned_due_at and all discount/fee/deduction amounts >= 0. Usage limits are checked by locking the promotion while confirming an order; rejected or cancelled orders do not consume usage.'
}

Table rental_order_items {
  id uuid [pk]
  order_id uuid [not null]
  variant_id uuid [not null]
  unit_id uuid
  allocation_status allocation_status [not null, default: 'UNASSIGNED']
  occupied_from timestamptz [not null]
  occupied_until timestamptz [not null]
  allocated_by uuid
  billable_days int [not null]
  unit_daily_price_vnd bigint [not null]
  unit_deposit_vnd bigint [not null]
  pickup_condition_grade costume_condition_grade
  pickup_evidence_key varchar(500)
  return_condition_grade costume_condition_grade
  is_missing boolean [not null, default: false]
  damage_notes text
  return_evidence_key varchar(500)
  damage_fee_vnd bigint [not null, default: 0]
  missing_fee_vnd bigint [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (order_id, allocation_status)
  }

  Note: 'One row represents one requested physical costume, so quantity is always one. Price and deposit are copied from costume_variants and become immutable after confirmation. Rental total is calculated as billable_days * unit_daily_price_vnd instead of being stored. unit_id is null only while UNASSIGNED. Pickup requires an assigned READY unit and an inspected pickup_condition_grade other than UNINSPECTED; return_condition_grade also cannot be UNINSPECTED when set. Require occupied_from < occupied_until, billable_days > 0 and non-negative money fields. PostgreSQL migration must add a GiST exclusion constraint preventing one unit from having overlapping HELD/CONFIRMED/ACTIVE periods.'
}

Table rental_item_accessories {
  id uuid [pk]
  order_item_id uuid [not null]
  model_accessory_id uuid
  accessory_name varchar(255) [not null]
  quantity_out int [not null]
  quantity_returned int
  condition_out costume_condition_grade
  condition_in costume_condition_grade
  unit_replacement_value_vnd bigint [not null]
  damage_fee_vnd bigint [not null, default: 0]
  missing_fee_vnd bigint [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (order_item_id, model_accessory_id) [unique]
  }

  Note: 'Accessory handover/return snapshot for one rental item. model_accessory_id may become null because name and replacement value are preserved snapshots. Require quantity_out > 0; quantity_returned is null before return or between 0 and quantity_out; condition values cannot be UNINSPECTED when set; all money fields must be non-negative.'
}

// ============================================================
// FINANCE, DEPOSIT, REFUND AND RECONCILIATION
// ============================================================

Table payments {
  id uuid [pk]
  order_id uuid [not null]
  purpose payment_purpose [not null]
  method payment_method [not null]
  amount_vnd bigint [not null]
  status payment_status [not null, default: 'PENDING']
  provider varchar(100)
  provider_payment_id varchar(255)
  idempotency_key varchar(255) [not null, unique]
  recorded_by uuid
  paid_at timestamptz
  failure_reason text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (order_id, status)
    (provider, provider_payment_id) [unique]
  }

  Note: 'Amount must be positive. SUCCEEDED is evidence that money was received and requires paid_at. Manual cash/bank payments require recorded_by; gateway payments require a provider payment id. RENTAL, DEPOSIT and EXTRA remain separate purposes.'
}

Table refunds {
  id uuid [pk]
  payment_id uuid [not null]
  amount_vnd bigint [not null]
  reason text [not null]
  status refund_status [not null, default: 'REQUESTED']
  requested_by uuid [not null]
  approved_by uuid
  provider_refund_id varchar(255) [unique]
  completed_at timestamptz
  failure_reason text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (payment_id, status)
  }

  Note: 'Total COMPLETED refunds must not exceed the amount of the referenced SUCCEEDED payment.'
}

Table provider_webhook_events {
  id uuid [pk]
  payment_id uuid
  provider varchar(100) [not null]
  event_id varchar(255) [not null]
  event_type varchar(100) [not null]
  payload_json jsonb [not null]
  received_at timestamptz [not null, default: `now()`]
  processed_at timestamptz
  processing_status varchar(30) [not null]
  error_message text

  indexes {
    (provider, event_id) [unique]
    (processing_status, received_at)
  }

  Note: 'Persist only after provider signature verification. Duplicate provider/event ids return the prior result without applying payment or refund changes twice.'
}

// ============================================================
// CUSTOMER RELATIONSHIP MANAGEMENT
// ============================================================

Table customers {
  user_id uuid [pk]
  customer_code varchar(50) [not null, unique]
  preferred_branch_id uuid
  birthday date
  height_cm decimal(5,2)
  weight_kg decimal(5,2)
  chest_cm decimal(5,2)
  waist_cm decimal(5,2)
  hip_cm decimal(5,2)
  internal_note text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Customer-only business data. Identity/contact data stays in users; rental history comes from rental_orders; payment totals come from payments. birthday cannot be in the future. Measurements are optional and must be greater than zero when set. internal_note is staff-only.'
}

Table customer_interactions {
  id uuid [pk]
  customer_user_id uuid [not null]
  branch_id uuid
  order_id uuid
  case_id uuid
  staff_user_id uuid
  interaction_type customer_interaction_type [not null]
  channel interaction_channel [not null]
  summary text [not null]
  occurred_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (customer_user_id, occurred_at)
    (case_id, occurred_at)
  }

  Note: 'Customer timeline. Optional branch/order/case/staff links become null if their parent is deleted. Direct updates are forbidden; retention/admin may delete old rows.'
}

Table crm_cases {
  id uuid [pk]
  case_code varchar(50) [not null, unique]
  customer_user_id uuid [not null]
  order_id uuid
  branch_id uuid [not null]
  subject varchar(255) [not null]
  description text
  case_type varchar(50) [not null]
  priority crm_case_priority [not null, default: 'NORMAL']
  status crm_case_status [not null, default: 'OPEN']
  owner_user_id uuid
  due_at timestamptz
  resolved_at timestamptz
  closed_at timestamptz
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (branch_id, status, due_at)
    (owner_user_id, status, due_at)
    (customer_user_id, created_at)
  }

  Note: 'Operational customer-service ticket. RESOLVED requires resolved_at; CLOSED requires resolved_at and closed_at. If order_id is set, that order must belong to customer_user_id.'
}

Table crm_case_history {
  id uuid [pk]
  case_id uuid [not null]
  event_type crm_case_event_type [not null]
  from_status crm_case_status
  to_status crm_case_status
  from_owner_user_id uuid
  to_owner_user_id uuid
  note text
  actor_user_id uuid
  occurred_at timestamptz [not null, default: `now()`]

  indexes {
    (case_id, occurred_at)
  }

  Note: 'Case workflow history. The actor link may become null if the employee is deleted. Direct updates are forbidden; retention/admin may delete old rows. CREATED initializes the case; STATUS_CHANGED and OWNER_CHANGED must contain their corresponding before/after values.'
}

// ============================================================
// PLATFORM EVENTS
// ============================================================

Table outbox_events {
  id uuid [pk]
  event_type varchar(150) [not null]
  aggregate_type varchar(100) [not null]
  aggregate_id uuid [not null]
  payload_json jsonb [not null]
  status outbox_status [not null, default: 'PENDING']
  available_at timestamptz [not null, default: `now()`]
  processed_at timestamptz
  retry_count int [not null, default: 0]
  last_error text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (status, available_at)
  }

  Note: 'Created in the same transaction as the business change; consumers must be idempotent. retry_count must be non-negative. PROCESSED requires processed_at; non-PROCESSED rows keep processed_at null. Workers retry eligible PENDING/FAILED events at available_at and record the last error.'
}

// ============================================================
// RELATIONSHIPS
// ============================================================

Ref: users.id < auth_identities.user_id
Ref: users.id < refresh_sessions.user_id [delete: cascade]
Ref: users.id - employees.user_id
Ref: users.id < employees.created_by
Ref: roles.id < role_permissions.role_id
Ref: permissions.id < role_permissions.permission_id
Ref: users.id < user_role_assignments.user_id
Ref: roles.id < user_role_assignments.role_id
Ref: branches.id < user_role_assignments.branch_id
Ref: users.id < user_role_assignments.assigned_by

Ref: costume_categories.id < costume_categories.parent_id
Ref: costume_categories.id < costume_models.category_id
Ref: costume_models.id < costume_model_accessories.model_id
Ref: costume_models.id < costume_variants.model_id
Ref: costume_models.id < costume_media.model_id
Ref: costume_variants.id < costume_media.variant_id
Ref: costume_variants.id < costume_units.variant_id
Ref: branches.id < costume_units.current_branch_id
Ref: costume_units.id < unit_events.unit_id
Ref: stock_transfers.id < unit_events.stock_transfer_id
Ref: branches.id < unit_events.from_branch_id
Ref: branches.id < unit_events.to_branch_id
Ref: employees.user_id < unit_events.recorded_by
Ref: costume_units.id < unit_blocks.unit_id
Ref: employees.user_id < unit_blocks.assigned_to
Ref: employees.user_id < unit_blocks.created_by
Ref: branches.id < stock_transfers.from_branch_id
Ref: branches.id < stock_transfers.to_branch_id
Ref: employees.user_id < stock_transfers.requested_by
Ref: employees.user_id < stock_transfers.approved_by
Ref: employees.user_id < stock_transfers.shipped_by
Ref: employees.user_id < stock_transfers.received_by
Ref: employees.user_id < stock_transfers.ended_by
Ref: stock_transfers.id < stock_transfer_items.transfer_id
Ref: costume_units.id < stock_transfer_items.unit_id

Ref: users.id < rental_policy_versions.created_by
Ref: users.id < promotions.created_by

Ref: customers.user_id < rental_orders.customer_user_id
Ref: branches.id < rental_orders.pickup_branch_id
Ref: rental_policy_versions.id < rental_orders.policy_version_id
Ref: promotions.id < rental_orders.promotion_id
Ref: users.id < rental_orders.created_by
Ref: employees.user_id < rental_orders.pickup_processed_by
Ref: employees.user_id < rental_orders.return_processed_by
Ref: rental_orders.id < rental_order_items.order_id
Ref: costume_variants.id < rental_order_items.variant_id
Ref: costume_units.id < rental_order_items.unit_id
Ref: employees.user_id < rental_order_items.allocated_by
Ref: rental_order_items.id < rental_item_accessories.order_item_id
Ref: costume_model_accessories.id < rental_item_accessories.model_accessory_id

Ref: rental_orders.id < payments.order_id
Ref: employees.user_id < payments.recorded_by
Ref: payments.id < refunds.payment_id
Ref: users.id < refunds.requested_by
Ref: employees.user_id < refunds.approved_by
Ref: payments.id < provider_webhook_events.payment_id

Ref: users.id - customers.user_id
Ref: branches.id < customers.preferred_branch_id
Ref: customers.user_id < customer_interactions.customer_user_id
Ref: branches.id < customer_interactions.branch_id
Ref: rental_orders.id < customer_interactions.order_id
Ref: crm_cases.id < customer_interactions.case_id
Ref: employees.user_id < customer_interactions.staff_user_id
Ref: customers.user_id < crm_cases.customer_user_id
Ref: rental_orders.id < crm_cases.order_id
Ref: branches.id < crm_cases.branch_id
Ref: employees.user_id < crm_cases.owner_user_id
Ref: employees.user_id < crm_cases.created_by
Ref: crm_cases.id < crm_case_history.case_id
Ref: employees.user_id < crm_case_history.from_owner_user_id
Ref: employees.user_id < crm_case_history.to_owner_user_id
Ref: employees.user_id < crm_case_history.actor_user_id

