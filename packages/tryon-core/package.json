{
  "name": "@practics/tryon-core",
  "version": "0.2.0",
  "private": true,
  "description": "On-device virtual try-on pipeline: person segmentation, pose estimation, garment warp, and compositing.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workers": {
      "types": "./dist/workers.d.ts",
      "import": "./dist/workers.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@litertjs/core": "^2.5.2",
    "@litertjs/tfjs-interop": "^2.5.0",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "litert-react": "workspace:*",
    "thin-plate-spline": "workspace:*"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
