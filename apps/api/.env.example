NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/costume_rental
# Set a randomly generated secret of at least 32 characters before using protected APIs.
# JWT_ACCESS_SECRET=
JWT_ISSUER=costume-api
JWT_AUDIENCE=costume-web
# Generate a separate random secret of at least 32 characters.
# OTP_HASH_SECRET=
# console works ONLY when NODE_ENV=development. Never enable it in production.
OTP_DELIVERY_MODE=disabled

# SMTP delivery for registration, password-reset, and email-change OTPs.
# Gmail development example: smtp.gmail.com / 465 / true, using an App Password.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Costume Rental Studio
MAIL_FROM_ADDRESS=

# Google OAuth 2.0 credentials for a Web application.
# Client ID may be used by the frontend; Client Secret must remain backend-only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# SeaweedFS S3 gateway. Set the five required S3 variables together.
# S3_PUBLIC_ENDPOINT must be reachable by browser clients.
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=300
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_MAX_MODEL_IMAGES=10
MEDIA_MAX_VARIANT_IMAGES=5
MEDIA_MAX_IMAGE_DIMENSION=8000
MEDIA_MAX_IMAGE_PIXELS=40000000
MEDIA_DELETE_WORKER_INTERVAL_SECONDS=10
MEDIA_DELETE_MAX_RETRIES=10
MEDIA_OUTBOX_RETENTION_DAYS=30
MEDIA_ORPHAN_RETENTION_HOURS=24
MEDIA_ORPHAN_CLEANUP_INTERVAL_SECONDS=3600
# Public/read-only media origin, typically a CDN or reverse-proxy domain.
MEDIA_PUBLIC_BASE_URL=

# payOS checkout. All five values must be set together.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Unique 1-999 prefix per environment sharing the same payOS merchant account.
PAYOS_ORDER_CODE_PREFIX=
PAYOS_CHECKOUT_BASE_URL=https://pay.payos.vn/web
PAYOS_RETURN_URL=http://localhost:3000/payments/success
PAYOS_CANCEL_URL=http://localhost:3000/payments/cancel
