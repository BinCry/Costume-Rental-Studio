  pickupProcessedBy    String?               @map("pickup_processed_by") @db.Uuid
  pickedUpAt           DateTime?             @map("picked_up_at") @db.Timestamptz(6)
  returnProcessedBy    String?               @map("return_processed_by") @db.Uuid
  returnedAt           DateTime?             @map("returned_at") @db.Timestamptz(6)
  inspectionStatus     InspectionStatus?     @map("inspection_status")
  returnNotes          String?               @map("return_notes") @db.Text
