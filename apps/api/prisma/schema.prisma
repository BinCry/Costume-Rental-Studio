generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  LOCKED
  INACTIVE

  @@map("user_status")
}

enum BranchStatus {
  ACTIVE
  INACTIVE

  @@map("branch_status")
}

enum ActorGroup {
  ADMIN
  STAFF
  CUSTOMER

  @@map("actor_group")
}

enum PermissionScope {
  OWN
  BRANCH
  ALL

  @@map("permission_scope")
}

enum CatalogStatus {
  ACTIVE
  INACTIVE

  @@map("catalog_status")
}

enum BillingDayMode {
  CALENDAR_DAY
  ROLLING_24_HOURS

  @@map("billing_day_mode")
}

enum DiscountType {
  PERCENT
  FIXED_AMOUNT

  @@map("discount_type")
}

enum UnitOperationalStatus {
  INBOUND
  READY
  CLEANING
  REPAIR
  IN_TRANSFER
  RETIRED

  @@map("unit_operational_status")
}

enum CostumeConditionGrade {
  UNINSPECTED
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED

  @@map("costume_condition_grade")
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED

  @@map("employment_status")
}

enum UnitBlockType {
  CLEANING
  REPAIR
  ALTERATION
  INSPECTION
  INTERNAL_USE
  MANUAL
  OTHER

  @@map("unit_block_type")
}

enum UnitBlockStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("unit_block_status")
}

enum TransferStatus {
  REQUESTED
  APPROVED
  IN_TRANSIT
  RECEIVED
  REJECTED
  CANCELLED

  @@map("transfer_status")
}

enum OrderStatus {
  DRAFT
  PENDING_CONFIRMATION
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  ACTIVE
  RETURN_INSPECTION
  COMPLETED
  REJECTED
  CANCELLED
  NO_SHOW

  @@map("order_status")
}

enum AllocationStatus {
  UNASSIGNED
  HELD
  CONFIRMED
  ACTIVE
  RELEASED
  COMPLETED

  @@map("allocation_status")
}

enum RentalEvidencePhase {
  PICKUP
  RETURN

  @@map("rental_evidence_phase")
}

enum InspectionStatus {
  PENDING_ASSESSMENT
  PASSED
  HAS_DAMAGE
  HAS_MISSING_ITEM
  COMPLETED

  @@map("inspection_status")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED

  @@map("payment_status")
}

enum PaymentPurpose {
  RENTAL
  DEPOSIT
  EXTRA

  @@map("payment_purpose")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  PAYMENT_GATEWAY

  @@map("payment_method")
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  REJECTED
  FAILED

  @@map("refund_status")
}

enum CrmCaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@map("crm_case_status")
}

enum CrmCasePriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("crm_case_priority")
}

enum CustomerInteractionType {
  INQUIRY
  CONSULTATION
  COMPLAINT
  FOLLOW_UP
  NOTE

  @@map("customer_interaction_type")
}

enum InteractionChannel {
  IN_PERSON
  PHONE
  EMAIL
  CHAT
  SOCIAL

  @@map("interaction_channel")
}

enum CrmCaseEventType {
  CREATED
  STATUS_CHANGED
  OWNER_CHANGED

  @@map("crm_case_event_type")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED

  @@map("outbox_status")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String?    @unique @db.VarChar(255)
  phone           String?    @unique @db.VarChar(30)
  passwordHash    String?    @map("password_hash") @db.VarChar(255)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  displayName     String     @map("display_name") @db.VarChar(255)
  avatarUrl       String?    @map("avatar_url") @db.VarChar(500)
  status          UserStatus
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  authIdentities         AuthIdentity[]
  refreshSessions        RefreshSession[]
  passwordResetChallenge PasswordResetChallenge?
  emailChangeChallenge   EmailChangeChallenge?
  employee               Employee?               @relation("EmployeeUser")
  employeesCreated       Employee[]              @relation("EmployeeCreatedBy")
  roleAssignments        UserRoleAssignment[]    @relation("RoleAssignmentUser")
  roleAssignmentsMade    UserRoleAssignment[]    @relation("RoleAssignmentAssigner")
  policyVersionsCreated  RentalPolicyVersion[]
  promotionsCreated      Promotion[]
  rentalOrdersCreated    RentalOrder[]           @relation("RentalOrderCreator")
  rentalEvidenceUploaded RentalItemEvidence[]    @relation("RentalEvidenceUploader")
  rentalOrderEvents      RentalOrderEvent[]      @relation("RentalOrderEventActor")
  refundsRequested       Refund[]                @relation("RefundRequester")
  customer               Customer?               @relation("CustomerUser")

  @@map("users")
}

model RefreshSession {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  familyId        String    @map("family_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash") @db.VarChar(64)
  deviceId        String?   @map("device_id") @db.VarChar(100)
  deviceName      String?   @map("device_name") @db.VarChar(255)
  userAgent       String?   @map("user_agent") @db.VarChar(500)
  lastIp          String?   @map("last_ip") @db.VarChar(45)
  familyCreatedAt DateTime  @map("family_created_at") @db.Timestamptz(6)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt          DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model EmailOtpChallenge {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  codeHash     String    @map("code_hash") @db.VarChar(64)
  attemptCount Int       @default(0) @map("attempt_count")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  sentAt       DateTime? @map("sent_at") @db.Timestamptz(6)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("email_otp_challenges")
}

model PasswordResetChallenge {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @unique @map("user_id") @db.Uuid
  codeHash            String    @map("code_hash") @db.VarChar(64)
  attemptCount        Int       @default(0) @map("attempt_count")
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(6)
  sentAt              DateTime? @map("sent_at") @db.Timestamptz(6)
  verifiedAt          DateTime? @map("verified_at") @db.Timestamptz(6)
  resetTokenHash      String?   @unique @map("reset_token_hash") @db.VarChar(64)
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at") @db.Timestamptz(6)
  consumedAt          DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_challenges")
}

model EmailChangeChallenge {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @unique @map("user_id") @db.Uuid
  newEmail     String    @map("new_email") @db.VarChar(255)
  codeHash     String    @map("code_hash") @db.VarChar(64)
  attemptCount Int       @default(0) @map("attempt_count")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  sentAt       DateTime? @map("sent_at") @db.Timestamptz(6)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_change_challenges")
}

model AuthIdentity {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  provider        String   @db.VarChar(50)
  providerSubject String   @map("provider_subject") @db.VarChar(255)
  emailAtLinkTime String   @map("email_at_link_time") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@map("auth_identities")
}

model Employee {
  userId           String           @id @map("user_id") @db.Uuid
  employeeCode     String           @unique @map("employee_code") @db.VarChar(50)
  employmentStatus EmploymentStatus @default(ACTIVE) @map("employment_status")
  joinedAt         DateTime         @map("joined_at") @db.Date
  terminatedAt     DateTime?        @map("terminated_at") @db.Date
  activatedAt      DateTime?        @map("activated_at") @db.Timestamptz(6)
  createdBy        String           @map("created_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                 User                  @relation("EmployeeUser", fields: [userId], references: [id], onDelete: Cascade)
  creator              User                  @relation("EmployeeCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  unitEventsRecorded   UnitEvent[]
  unitBlocksAssigned   UnitBlock[]           @relation("UnitBlockAssignee")
  unitBlocksCreated    UnitBlock[]           @relation("UnitBlockCreator")
  transfersRequested   StockTransfer[]       @relation("TransferRequester")
  transfersApproved    StockTransfer[]       @relation("TransferApprover")
  transfersShipped     StockTransfer[]       @relation("TransferShipper")
  transfersReceived    StockTransfer[]       @relation("TransferReceiver")
  transfersEnded       StockTransfer[]       @relation("TransferEnder")
  pickupsProcessed     RentalOrder[]         @relation("RentalOrderPickupProcessor")
  returnsProcessed     RentalOrder[]         @relation("RentalOrderReturnProcessor")
  orderItemsAllocated  RentalOrderItem[]
  paymentsRecorded     Payment[]
  refundsApproved      Refund[]              @relation("RefundApprover")
  customerInteractions CustomerInteraction[]
  crmCasesOwned        CrmCase[]             @relation("CrmCaseOwner")
  crmCasesCreated      CrmCase[]             @relation("CrmCaseCreator")
  caseHistoryFromOwner CrmCaseHistory[]      @relation("CrmHistoryFromOwner")
  caseHistoryToOwner   CrmCaseHistory[]      @relation("CrmHistoryToOwner")
  caseHistoryActed     CrmCaseHistory[]      @relation("CrmHistoryActor")

  @@map("employees")
}

model Branch {
  id         String       @id @default(uuid()) @db.Uuid
  branchCode String       @unique @map("branch_code") @db.VarChar(50)
  name       String       @db.VarChar(255)
  address    String       @db.Text
  phone      String?      @db.VarChar(30)
  timezone   String       @default("Asia/Ho_Chi_Minh") @db.VarChar(100)
  status     BranchStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  roleAssignments    UserRoleAssignment[]
  costumeUnits       CostumeUnit[]
  unitEventsFrom     UnitEvent[]           @relation("UnitEventFromBranch")
  unitEventsTo       UnitEvent[]           @relation("UnitEventToBranch")
  transfersFrom      StockTransfer[]       @relation("TransferFromBranch")
  transfersTo        StockTransfer[]       @relation("TransferToBranch")
  rentalOrders       RentalOrder[]
  preferredCustomers Customer[]
  interactions       CustomerInteraction[]
  crmCases           CrmCase[]

  @@map("branches")
}

model Role {
  id              String               @id @default(uuid()) @db.Uuid
  roleCode        String               @unique @map("role_code") @db.VarChar(100)
  name            String               @db.VarChar(255)
  actorGroup      ActorGroup           @map("actor_group")
  isActive        Boolean              @default(true) @map("is_active")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  rolePermissions RolePermission[]
  assignments     UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique @db.VarChar(150)
  module          String           @db.VarChar(100)
  action          String           @db.VarChar(100)
  scope           PermissionScope
  description     String?          @db.Text
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  branchId   String?  @map("branch_id") @db.Uuid
  assignedBy String   @map("assigned_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User     @relation("RoleAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  assigner   User     @relation("RoleAssignmentAssigner", fields: [assignedBy], references: [id], onDelete: Restrict)

  @@index([branchId, roleId])
  @@map("user_role_assignments")
}

model CostumeCategory {
  id        String            @id @default(uuid()) @db.Uuid
  parentId  String?           @map("parent_id") @db.Uuid
  name      String            @db.VarChar(255)
  status    CatalogStatus     @default(ACTIVE)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent    CostumeCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children  CostumeCategory[] @relation("CategoryHierarchy")
  models    CostumeModel[]

  @@index([parentId])
  @@map("costume_categories")
}

model CostumeModel {
  id               String                  @id @default(uuid()) @db.Uuid
  modelCode        String                  @unique @map("model_code") @db.VarChar(50)
  categoryId       String                  @map("category_id") @db.Uuid
  name             String                  @db.VarChar(255)
  shortDescription String?                 @map("short_description") @db.VarChar(500)
  description      String?                 @db.Text
  material         String?                 @db.VarChar(255)
  status           CatalogStatus           @default(ACTIVE)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  category         CostumeCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  accessories      CostumeModelAccessory[]
  variants         CostumeVariant[]
  media            CostumeMedia[]

  @@index([categoryId, status])
  @@map("costume_models")
}

model CostumeModelAccessory {
  id                  String                @id @default(uuid()) @db.Uuid
  modelId             String                @map("model_id") @db.Uuid
  name                String                @db.VarChar(255)
  defaultQuantity     Int                   @default(1) @map("default_quantity")
  replacementValueVnd BigInt?               @map("replacement_value_vnd")
  isActive            Boolean               @default(true) @map("is_active")
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  model               CostumeModel          @relation(fields: [modelId], references: [id], onDelete: Cascade)
  rentalItemSnapshots RentalItemAccessory[]

  @@unique([modelId, name])
  @@map("costume_model_accessories")
}

model CostumeVariant {
  id                    String            @id @default(uuid()) @db.Uuid
  variantCode           String            @unique @map("variant_code") @db.VarChar(50)
  modelId               String            @map("model_id") @db.Uuid
  sizeCode              String            @map("size_code") @db.VarChar(50)
  colorCode             String            @map("color_code") @db.VarChar(50)
  editionLabel          String?           @map("edition_label") @db.VarChar(100)
  fitNotes              String?           @map("fit_notes") @db.Text
  dailyRentalPriceVnd   BigInt            @map("daily_rental_price_vnd")
  depositAmountVnd      BigInt            @map("deposit_amount_vnd")
  replacementValueVnd   BigInt            @map("replacement_value_vnd")
  cleaningBufferMinutes Int?              @map("cleaning_buffer_minutes")
  status                CatalogStatus     @default(ACTIVE)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  model                 CostumeModel      @relation(fields: [modelId], references: [id], onDelete: Restrict)
  media                 CostumeMedia[]
  units                 CostumeUnit[]
  orderItems            RentalOrderItem[]

  @@index([modelId, status])
  @@map("costume_variants")
}

model CostumeMedia {
  id              String          @id @default(uuid()) @db.Uuid
  modelId         String?         @map("model_id") @db.Uuid
  variantId       String?         @map("variant_id") @db.Uuid
  objectKey       String          @unique @map("object_key") @db.VarChar(500)
  sourceUploadKey String?         @unique @map("source_upload_key") @db.VarChar(500)
  sortOrder       Int             @default(0) @map("sort_order")
  altText         String?         @map("alt_text") @db.VarChar(500)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  model           CostumeModel?   @relation(fields: [modelId], references: [id], onDelete: Restrict)
  variant         CostumeVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([modelId, sortOrder])
  @@index([variantId, sortOrder])
  @@map("costume_media")
}

model CostumeUnit {
  id                 String                @id @default(uuid()) @db.Uuid
  unitCode           String                @unique @map("unit_code") @db.VarChar(50)
  variantId          String                @map("variant_id") @db.Uuid
  currentBranchId    String                @map("current_branch_id") @db.Uuid
  conditionGrade     CostumeConditionGrade @default(UNINSPECTED) @map("condition_grade")
  conditionNotes     String?               @map("condition_notes") @db.Text
  operationalStatus  UnitOperationalStatus @default(INBOUND) @map("operational_status")
  acquiredAt         DateTime?             @map("acquired_at") @db.Date
  acquisitionCostVnd BigInt?               @map("acquisition_cost_vnd")
  retiredAt          DateTime?             @map("retired_at") @db.Timestamptz(6)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  variant            CostumeVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  currentBranch      Branch                @relation(fields: [currentBranchId], references: [id], onDelete: Restrict)
  events             UnitEvent[]
  blocks             UnitBlock[]
  transferItems      StockTransferItem[]
  orderItems         RentalOrderItem[]

  @@index([variantId, currentBranchId, operationalStatus])
  @@index([currentBranchId, operationalStatus])
  @@map("costume_units")
}

model UnitEvent {
  id              String         @id @default(uuid()) @db.Uuid
  unitId          String         @map("unit_id") @db.Uuid
  stockTransferId String?        @map("stock_transfer_id") @db.Uuid
  eventType       String         @map("event_type") @db.VarChar(50)
  fromBranchId    String?        @map("from_branch_id") @db.Uuid
  toBranchId      String?        @map("to_branch_id") @db.Uuid
  recordedBy      String?        @map("recorded_by") @db.Uuid
  occurredAt      DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)
  notes           String?        @db.Text
  unit            CostumeUnit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  stockTransfer   StockTransfer? @relation(fields: [stockTransferId], references: [id], onDelete: SetNull)
  fromBranch      Branch?        @relation("UnitEventFromBranch", fields: [fromBranchId], references: [id], onDelete: SetNull)
  toBranch        Branch?        @relation("UnitEventToBranch", fields: [toBranchId], references: [id], onDelete: SetNull)
  recorder        Employee?      @relation(fields: [recordedBy], references: [userId], onDelete: SetNull)

  @@index([unitId, occurredAt])
  @@map("unit_events")
}

model UnitBlock {
  id           String          @id @default(uuid()) @db.Uuid
  unitId       String          @map("unit_id") @db.Uuid
  blockType    UnitBlockType   @map("block_type")
  status       UnitBlockStatus @default(PLANNED)
  blockedFrom  DateTime        @map("blocked_from") @db.Timestamptz(6)
  blockedUntil DateTime        @map("blocked_until") @db.Timestamptz(6)
  assignedTo   String?         @map("assigned_to") @db.Uuid
  costVnd      BigInt?         @map("cost_vnd")
  reason       String          @db.Text
  notes        String?         @db.Text
  startedAt    DateTime?       @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime?       @map("finished_at") @db.Timestamptz(6)
  createdBy    String?         @map("created_by") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  unit         CostumeUnit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  assignee     Employee?       @relation("UnitBlockAssignee", fields: [assignedTo], references: [userId], onDelete: SetNull)
  creator      Employee?       @relation("UnitBlockCreator", fields: [createdBy], references: [userId], onDelete: SetNull)

  @@index([unitId, blockedFrom, blockedUntil])
  @@index([assignedTo, status, blockedFrom])
  @@map("unit_blocks")
}

model StockTransfer {
  id           String              @id @default(uuid()) @db.Uuid
  transferCode String              @unique @map("transfer_code") @db.VarChar(50)
  fromBranchId String              @map("from_branch_id") @db.Uuid
  toBranchId   String              @map("to_branch_id") @db.Uuid
  status       TransferStatus      @default(REQUESTED)
  requestNote  String?             @map("request_note") @db.Text
  requestedBy  String              @map("requested_by") @db.Uuid
  approvedBy   String?             @map("approved_by") @db.Uuid
  approvedAt   DateTime?           @map("approved_at") @db.Timestamptz(6)
  shippedBy    String?             @map("shipped_by") @db.Uuid
  shippedAt    DateTime?           @map("shipped_at") @db.Timestamptz(6)
  receivedBy   String?             @map("received_by") @db.Uuid
  receivedAt   DateTime?           @map("received_at") @db.Timestamptz(6)
