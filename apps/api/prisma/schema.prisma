  pickupProcessor      Employee?             @relation("RentalOrderPickupProcessor", fields: [pickupProcessedBy], references: [userId], onDelete: SetNull)
  returnProcessor      Employee?             @relation("RentalOrderReturnProcessor", fields: [returnProcessedBy], references: [userId], onDelete: SetNull)
