  method            PaymentMethod
  amountVnd         BigInt                 @map("amount_vnd")
  status            PaymentStatus          @default(PENDING)
  provider          String?                @db.VarChar(100)
  providerPaymentId String?                @map("provider_payment_id") @db.VarChar(255)
  providerOrderCode BigInt?                @map("provider_order_code")
  providerStatus    String?                @map("provider_status") @db.VarChar(30)
  transactionReference String?             @map("transaction_reference") @db.VarChar(255)
  checkoutUrl       String?                @map("checkout_url") @db.VarChar(1000)
  qrCode            String?                @map("qr_code") @db.Text
  expiresAt         DateTime?              @map("expires_at") @db.Timestamptz(6)
  idempotencyKey    String                 @unique @map("idempotency_key") @db.VarChar(255)
