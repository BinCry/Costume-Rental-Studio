  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer             Customer              @relation(fields: [customerUserId], references: [userId], onDelete: Restrict)
  pickupBranch         Branch                @relation(fields: [pickupBranchId], references: [id], onDelete: Restrict)
  policyVersion        RentalPolicyVersion   @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  promotion            Promotion?            @relation(fields: [promotionId], references: [id], onDelete: Restrict)
